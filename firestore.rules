rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Read-only public dataset for the "on this day in history" feature
    // (see GetAlbumsByDayUseCase). It's populated offline by
    // scripts/upload_day_index (Admin SDK, which bypasses these rules
    // entirely) — no client ever writes here.
    match /albumsByDay/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Cached tracklist + streaming-service links per album (AlbumDetailScreen),
    // keyed by the same release-group MBID as albumsByDay — same offline
    // pipeline, same read-only shape (see scripts/upload_day_index.py).
    match /albumTracks/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
